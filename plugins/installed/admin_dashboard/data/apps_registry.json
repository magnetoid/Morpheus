      "tagline": "High-contrast editorial theme with serif display + sticky filter rail. Built for indie publishers + lifestyle brands.",
      "category": "Themes",
      "author": "first-party",
      "version": "0.1.0",
      "requires": [],
      "repo": "https://github.com/magnetoid/morpheus-theme-noir",
      "install": "git clone https://github.com/magnetoid/morpheus-theme-noir themes/library/noir && export MORPHEUS_THEME=noir",
      "icon": "newspaper",
      "tags": [
        "theme",
        "magazine",
        "publishing",
        "editorial"
      ],
      "status": "planned"
    },
